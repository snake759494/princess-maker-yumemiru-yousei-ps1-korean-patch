{
 "7635": "메이드 일도 벌써 몇 번이나 갔더라~? 꼬맹이는 건방지고, 아줌마는 잔소리하고 지긋지긋해. 애초에 나는 메이드 체질이 아니야.",
 "7636": "벌써 몇 번이나 메이드 일 하러 갔더라? 메이드는 이제 싫어~. 애초에 남한테 부려지는 건 내 성미에 안 맞는 것 같아.",
 "7637": "메이드 일에도 꽤 익숙해졌어. 익숙해지니까 청소 같은 것도 즐겁네.",
 "7638": "광산 일은 힘들지만 급료가 좋아. 어차피 고생할 거면 수지맞는 알바여야지~.",
 "7639": "광산 일도 벌써 몇 번이나 했더라? 거긴 남자들뿐이라서 좀 무섭달까.",
 "7640": "광산 일도 벌써 몇 번이나 갔더라~? 거기 사람들 다 험상궂지만 의외로 좋은 사람들인가 봐. 난 마음에 들어.",
 "7641": "벌써 몇 번이나 광산에 갔더라? 옷도 손도 더러워지고, 이래서는 프린세스는 못 될 것 같아…… 하아…",
 "7642": "광산 일에도 꽤 익숙해졌어. 남자들 일터라고들 하지만 여자애라도 하면 할 수 있어.",
 "7643": "목수 일은 급료가 좋아서 멋져. 나 의외로 목수 체질일지도.",
 "7644": "목수 일도 벌써 몇 번이나 했더라? 왠지 거친 일터인 것 같아……",
 "7645": "목수 일도 벌써 몇 번이나 갔더라~? 걱정 안 해도 제대로 일하고 있어.",
 "7646": "벌써 몇 번이나 목수 일 하러 갔더라? 있지, 목수 출신 프린세스도 있을까? 아~아, 내 장래 좀 걱정돼…….",
 "7647": "목수 일에도 꽤 익숙해졌어. 지금은 꽤 의지가 되고 있달까.",
 "7648": "가정교사 아르바이트도 꽤 오래 했는데, 부잣집 애들은 까다로워서 감당이 안 돼.",
 "7649": "가정교사 일도 벌써 몇 번이나 했더라? 왠지 아이들이 나를 잘 따르는 느낌이야.",
 "7650": "가정교사 일도 벌써 몇 번이나 갔더라~? 아무래도 돈 많은 귀족은 껄끄러워.",
 "7651": "가정교사 일을 시작한 지 꽤 됐네. 후후, 이 나한테 배울 수 있다니 그 애들 정말 운이 좋아.",
 "7652": "가정교사 일에도 꽤 익숙해졌어. 그래도 아이를 가르치는 건 힘든 일이구나.",
 "7653": "아이 돌보기 일은 급료가 별로야. 그래도 괜찮아. 나 아이들 좋아하니까.",
 "7654": "아이 돌보기 일도 벌써 몇 번이나 했더라? 후후, 꼬마들은 귀여워~.",
 "7655": "아이 돌보기 일도 벌써 몇 번이나 갔더라~? 애들 상대는 싫지 않은데 피곤하단 말이야~.",
 "7656": "벌써 몇 번이나 아이 돌보기 하러 갔더라? 아이는 싫지 않지만, 이게 프린세스가 되는 데 도움이 될까? 왠지 장래가 불안해…….",
 "7657": "아이 돌보기 일에도 꽤 익숙해졌어. 아이들은 귀여워. 프린세스도 좋지만, 엄마도 동경하게 돼.",
 "7658": "왕궁은 호화롭고 또 호화로워서 눈이 부실 것 같아. 저런 곳에 살아 보고 싶어.",
 "7659": "왕궁은 정말 멋져. 프린세스가 되면 나도 왕궁에서 사는 거야?",
 "7660": "왕궁 일은 힘들고 관리들은 거만하고 싫은 일도 많지만…… 역시 조금 동경하게 돼.",
 "7661": "왕궁 사람들은 거만하지만, 내가 미래의 프린세스라는 걸 모르는 거야. 두고 보라지 하는 기분이야.",
 "7662": "왕궁 일에도 꽤 익숙해졌어. 처음엔 긴장했지만 이젠 괜찮아. 프린세스가 되면 나도 저런 곳에서 사는구나.",
 "7663": "경호원은 돈벌이가 돼서 좋긴 한데…… 나도 일단 프린세스를 꿈꾸는 여자애인데 말이야…….",
 "7664": "경호원은 왠지 무서~워. 여자애한테는 너무 위험한 아르바이트 같아…….",
 "7665": "경호원 알바는 좀 위험한 냄새가 나서 불타오르네. 그래도 이대로면 프린세스는 무리일 것 같아.",
 "7666": "나, 경호원 아르바이트는 왠지 싫어. 프린세스가 되기로 정했는데, 이런 걸 하고 있으면 무리라고……",
 "7667": "경호원은 왠지 무서운 일이야~. 이런 것만 하고 있으면 프린세스가 될 수 없어…….",
 "7668": "가사 돕기는 돈이 안 되니까 시간 낭비 같아~.",
 "7669": "가사 돕기도 몇 번이나 했더라? 이제 꽤 집안일 베테랑이 된 기분이야.",
 "7670": "벌써 몇 번이나 가사 돕기를 했더라~? 집에 가만히 있는 건 성미에 안 맞아. 어차피 아르바이트할 거면 확 화려한 일이 좋아.",
 "7671": "가사 돕기는 벌써 꽤 많이 한 것 같은데, 집에만 있어서는 프린세스 같은 건 될 수 없어.",
 "7672": "아빠, 나 집안일이 싫은 건 아니지만, 더 밖에 나가서 일하고 싶어.",
 "7673": "술집 손님은 왜 이상한 사람이 많을까? 뭐, 돈을 위해서 웬만한 건 참고 있지만~.",
 "7674": "술집은 왠지 즐거운 곳이야. 이상한 손님도 있지만, 다들 사실은 좋은 사람들일 거야.",
 "7675": "술집 일도 벌써 몇 번이나 갔더라~? 그나저나 술주정뱅이는 열받아~. 엉덩이를 만지고 그런다니까~. 믿을 수가 없어.",
 "7676": "술집 일을 시작한 지 꽤 됐네. 술집 일은 미래의 프린세스한테는 너무 가혹해. 하아…… 장래가 불안해.",
 "7677": "술집 일에도 꽤 익숙해졌어. 그래도 가끔 이상한 아저씨가 있어서 곤란해.",
 "7678": "호스티스 알바는 급료가 좋아서 나도 납득하고 있지만…… 프린세스를 목표로 하는 건 괜찮을까…….",
 "7679": "호스티스 일은 생각보다 재미있네. 나 의외로 어울릴지도. 우훗.",
 "7680": "호스티스 아르바이트를 시작한 지 꽤 됐네. 뭐, 이런 알바도 싫진 않지만, 프린세스 목표는 이제 그만둔 거야?",
 "7681": "나, 호스티스 아르바이트는 이제 싫어. 하나도 프린세스 후보답지 않은걸. 나한테 어울리는 우아한 일을 하고 싶어.",
 "7682": "술집 호스티스는 생각보다 힘든 일이네. 여러 사람을 만나서 공부가 되지만, 괴로운 일도 있어.",
 "7683": "학교에는 몇 번이나 갔지만, 가난하면 그럴 여유도 없네.",
 "7684": "학교에서 공부하는 것도 좋지만~, 댄스 교실 같은 데 더 가고 싶어~.",
 "7685": "학교에는 벌써 몇 번이나 갔지만, 사실은 별로 안 좋아해. 선생님이 나를 싫어하는 것 같고…….",
 "7686": "학교에는 벌써 몇 번이나 갔지만, 나만큼 우수한 애는 없는 것 같아. 뭐, 당연하다면 당연하지만~.",
 "7687": "아~아, 나아서 다시 공부하고 싶다…….",
 "7688": "학교는 몇 번을 가도 즐거워. 친구도 많고.",
 "7689": "무술 도장에는 벌써 꽤 다녔네. 처음엔 다치기라도 하면 손해라고 생각했는데, 계속해 보니 꽤 재밌어.",
 "7690": "무술 도장에는 벌써 몇 번이나 다녔더라? 처음엔 좀 무서웠는데~, 지금은 즐거운 것 같달까~.",
 "7691": "벌써 무술 도장에는 몇 번이나 갔더라…… 뭐, 공부 중에선 좋아하는 편이야. 몸 움직이는 건 싫지 않으니까.",
 "7692": "무술 수행이 프린세스가 되는 데 필요한 걸까? 나로서는 더 우아한 공부가 취향인데. 나 같은 레이디에게 어울리는 공부 말이야.",
 "7693": "무술 도장은 마음과 몸을 둘 다 단련할 수 있구나. 응, 앞으로도 힘내자~! 하는 느낌.",
 "7694": "댄스 교실은 즐거워서 좋은데, 학비가 비싸잖아? 아~아, 괴로워~. 돈이 없는 건 목이 없는 거랑 똑같아.",
 "7695": "댄스 교실 정말 좋아. 춤추는 건 즐겁고, 선생님도 멋지고, 더 가고 싶어. 부탁해, 아~빠, 보내 줘!",
 "7696": "댄스 교실에도 꽤 많이 다녔지…… 응, 댄스는 좋아. 꽤 좋아해. 그런데 그 선생님, 좀 여자 같아서 영……",
 "7697": "댄스 교실에도 꽤 다녔네. 멋진 프린세스가 되려면 중요한 공부라고 생각해. 응.",
 "7698": "댄스 교실에는 벌써 꽤 다녔네. 조금은 늘었을까. 어떻게 생각해? 아빠.",
 "7699": "요리 교실은 정말 좋아. 그야 학비는 들지만, 그만큼 집어 먹어서 본전 뽑고 있는걸.",
 "7700": "요리 교실은 즐거워. 나, 이래 봬도 요리 솜씨엔 자신 있어.",
 "7701": "요리 교실에는 벌써 몇 번이나 갔더라~. 요리는 내 체질이 아니지만, 과자 만드는 건 좋아하려나. 아, 먹는 건 더 좋아하지만.",
 "7702": "요리 교실에 몇 번이나 다녔으니, 이제 내 솜씨는 프로급일까? 아빠, 내 요리 맛있지?",
 "7703": "요리 교실에는 벌써 꽤 다녔네. 요리하는 건 정말 즐거워.",
 "7704": "음악 교실에도 벌써 몇 번이나 다니고 있지만, 으~음…… 음악 자체는 즐거운데 역시 학비가 아까워. 그만큼 아르바이트라도 하면 생활이 편해질 텐데……",
 "7705": "음악 교실은 즐거워. 나, 음악 정말 좋아해.",
 "7706": "음악 교실에도 몇 번이나 갔더라…… 음악은 마음을 풍요롭게 한다는데, 내 마음은 풍요로워졌을까…….",
 "7707": "음악 교실은 좋아. 나한테 어울리는 우아한 분위기가 있으니까. 아빠, 내 노래 듣고 싶어?",
 "7708": "음악 교실에는 벌써 꽤 다녔네. 나, 음악이 좋아~. 음악은 사람 마음을 즐겁게 해 주는 거구나.",
 "7709": "그림 교실에는 꽤 열심히 다니고 있지만…… 그래도 가난하니까. 가난한 화가라니 오싹한 장래상이야.",
 "7710": "그림 교실은 즐거워. 나, 의외로 재능이 있을지도. 에헤헤.",
 "7711": "그림 교실에는 벌써 몇 번 갔는지 몰라. 그림 그리기는 내 체질이 아니야. 뭐, 재밌으니까 됐지만.",
 "7712": "그림 교실에도 꽤 다녔네. 풍요로운 마음은 내 장래 설계에 빼놓을 수 없는 거라고 생각해. 앞으로도 힘낼게.",
 "7713": "그림 교실에는 벌써 꽤 다녔네. 그림 그리는 건 어렵지만, 해 보니 의외로 재밌어.",
 "7714": "예절 수업이 정말 내 장래에 도움이 될까. 프린세스가 되려면 예의범절이 중요한 건 확실하지만…… 소중한 돈을 들여서 공부하는 거니까 도움이 되게 해야지.",
 "7715": "있지, 아빠, 나 화예뻐? 우훗, 예절 공부를 꽤 많이 했는걸. 매력이 내면에서 배어 나올 거야.",
 "7716": "예절 수업 같은 건 내 체질이 아니야. 역시 프린세스가 되려면 그런 게 필요해?",
 "7717": "후후후, 예절 수업엔 이제 안 보내 줘도 돼. 나, 이미 예의범절이 충분히 몸에 뱄는걸.",
 "7718": "예절 수업에도 꽤 다녔네~. 조금은 훌륭한 몸가짐이 몸에 뱄을까? 어때, 나 레이디로 보여?",
 "7719": "교회에는 벌써 몇 번이나 갔더라? 교회는 정말 좋아. 공부도 되고 학비도 싸고.",
 "7720": "교회도 나쁘진 않은데~, 좀 딱딱해서 숨이 막혀. 나는 댄스 교실 같은 데가 어울린다고 생각해.",
 "7721": "교회에는 벌써 몇 번이나 갔더라…… 뭐, 교회는 싫지 않아. 앞으로도 가끔 가고 싶어.",
 "7722": "교회에는 벌써 꽤 많이 갔네. 교회? 물론 좋아하지. 교회에는 기품이 있잖아. 나한테 어울리는 곳이라고 생각해.",
 "7723": "교회는 몇 번이나 다니다 보면 자연스럽게 마음이 깨끗해지는 거야…… 정말일까?",
 "7724": "단식 도장은 사람한테 밥도 안 먹이면서 돈을 받다니 왠지 치사해~. 가난한 데다 배까지 고파서 최고로 비참한 기분이야.",
 "7725": "단식 도장은 다이어트도 되고 싫진 않은데~…… 역시 배고픈 게 괴로워~.",
 "7726": "이야~, 단식 도장에는 벌써 몇 번이나 다녔더라. 나로서는 밥을 참으면서까지 살 빼고 싶진 않은데.",
 "7727": "단식 도장에 다니기 시작한 지 벌써 몇 번째? 그야 배고픈 건 괴롭지만, 이상적인 몸매를 위해서라면 조금 고생쯤은 전~혀 괜찮아.",
 "7728": "단식 도장에 이렇게 많이 다니게 될 줄은 몰랐어. 나 그렇게 뚱뚱한가?",
 "7729": "",
