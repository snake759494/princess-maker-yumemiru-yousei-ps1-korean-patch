 "275": "센스  :{E}k{E}f0{E}%sence {E}%Bsence{E}f0{E}k {E}#17{E}#",
 "276": "매력  :{E}k{E}f0{E}%charm {E}%Bcharm{E}f0{E}k {E}#17{E}#",
 "277": "무용  :{E}k{E}f0{E}%buyu {E}%Bbuyu{E}f0{E}k {E}#17{E}#",
 "278": "피로도:{E}k{E}f0{E}%stls {E}%Bstls{E}f0{E}k {E}#17{E}#",
 "279": "신뢰도:{E}k{E}f0{E}%trust {E}%Btrust{E}f0{E}k {E}#17{E}#",
 "280": "체중　:{E}k{E}f0{E}%weight {E}%Bweight{E}f0{E}k {E}#17{E}#",
 "281": "제대로 일한 일수\n",
 "282": "　{E}%100일 중 {E}%101일 ({E}%102%)\n",
 "283": "수입　　{E}%vr2 G",
 "284": "우리 도장에 잘 왔다. 본인은 이 도장의 사범, 커클랜드이다.",
 "285": "무술을 배우는 것은 육체뿐 아니라 마음도 단련하는 일이다.",
 "286": "본인은 긍지를 갖고 그대를 이끌 것이다.",
 "287": "아~아, 다치기라도 하면 손해잖아~.",
 "288": "다들, 나랑 수련할 수 있어서 행복하겠네.",
 "289": "싫다, 나 왠지 무서워.",
 "290": "뭐, 안 다칠 정도로 열심히 해 볼까…….",
 "291": "네, 열심히 하겠습니다!",
 "292": "모두들, 몸보다도 마음을 갈고닦도록.",
 "293": "평소부터 마음을 다잡고 행동하도록.",
 "294": "또 이 도장에서 만나기를 기대하고 있겠다.",
 "295": "무도는 마음. 마음이 강한 자는 이윽고 크게 성장하는 법이다.",
 "296": "흠, 자만은 최대의 적이다……",
 "297": "자신을 겸허한 눈으로 다시 돌아보아라……",
 "298": "사람 위에는 늘 더 위가 있다. 그것을 잊어서는 안 된다.",
 "299": "그대는 소질은 좋다. 허나 금세 우쭐해지는 것이 흠이로다.",
 "300": "또 오너라. 그 근성을 뜯어고쳐 주마.",
 "301": "더울 때야말로 수련의 기회. 모두 기합 넣고 가자!",
 "302": "{E}%frstname 씨, 잠깐.",
 "303": "네?",
 "304": "내 이름은 아리엘. 너와 마찬가지로 무도에 뜻을 둔 자야.",
 "305": "하아……",
 "306": "나 말이야, 오늘까지 나에게 어울리는 라이벌을 찾아 왔어.",
 "307": "그런데 드디어 찾았어. 너야말로 나의 라이벌.",
 "308": "잠깐만. 라이벌이라니……",
 "309": "무예인에게는 절차탁마가 필요해. 앞으로의 승부가 기대되네. 그럼.",
 "310": "라이벌이라니? 곤란하네……",
 "311": "아가씨, 친구가 생긴 것 같네요. 럭키잖아요.",
 "312": "저기, {E}%frstname 씨……",
 "313": "왜?",
 "314": "지금까지 지내면서 잘 알았어. 너 참 좋은 사람이구나.",
 "315": "어?",
 "316": "나 전부터 너 같은 친구를 갖고 싶었어.",
 "317": "저기, 우리 오늘부터 단짝 하지 않을래?",
 "318": "어? ……단짝?",
 "319": "그래, 단짝. 같은 무도의 길을 걷는 사람으로서 말이야.",
 "320": "단짝이라……그래, 나도 아리엘이 싫지는 않으니까……",
 "321": "좋아. 단짝 하자.",
 "322": "기뻐! 앞으로도 잘 부탁해. 하지만 시합에선 봐주기 없기야.",
 "323": "그래, 단짝이니까 더더욱 봐줄 수는 없지.",
 "324": "아놀드",
 "325": "랜디",
 "326": "버크벡",
 "327": "체코",
 "328": "오늘은 시합을 하겠다. 평소 단련의 성과를 보여 다오.",
 "329": "{E}%frstname, 그대의 상대는",
 "330": "(이)다.",
 "331": "시합은 5판 승부로 3판을 먼저 따는 쪽이 이긴다.",
 "332": "서로 정정당당하게 겨루도록.",
 "333": "그럼, 연례 『무술 시합』을 하겠다. 수련의 성과를 보여 다오.",
 "334": "수련의 성과를 보여 주겠어.",
 "335": "간다! {E}%frstname!",
 "336": "훗, 봐주지 않을 거야!",
 "337": "내 수련의 성과를 보여 주지.",
 "338": "그래, 승부야, 아리엘!",
 "339": "안 질 거야!",
 "340": "좋아, 덤벼 봐!",
 "341": "좋~아!",
 "342": "승부!",
 "343": "어쩔 수 없네……",
 "344": "아프게 하지 마.",
 "345": "흥, 덤벼 봐!",
 "346": "나를 이길 수 있을 것 같아!?",
 "347": "가, 간다.",
 "348": "나는 안 질 거야.",
 "349": "아~아, 살살 해 줘……",
 "350": "싫~어, 무서워.",
 "351": "흥!",
 "352": "나, 나를 이길 수 있다고 생각하는 거야.",
 "353": "나, 나도 안 질 거니까.",
 "354": "봐주지 않을 거야.",
 "355": "아~아, 좀 봐줘……",
 "356": "에에~!? …………봐줘!",
 "357": "그건 내가 할 소리야.",
 "358": "내가 봐 드려도 괜찮답니다.",
 "359": "정정당당하게 겨룹시다.",
 "360": "내 솜씨를 가르쳐 주마.",
 "361": "별로 배우고 싶지 않은데……",
 "362": "싫~어.",
 "363": "훗, 그건 내가 할 소리야.",
 "364": "뭐어!? 건방진 태도네!",
 "365": "안 질 거야!",
 "366": "자, 승부다.",
 "367": "네네, 승부.",
 "368": "우후, 승부네.",
 "369": "훗!",
 "370": "한 수 가르쳐 줄게.",
 "371": "간다!",
 "372": "졌어……더 수련해야겠어.",
 "373": "윽! 강하네. 역시야!",
 "374": "……휴…또 처음부터 다시 시작이야.",
 "375": "실력이 늘었네, {E}%frstname. 하지만 나도 다음엔…!",
 "376": "후후, 다음 승부가 기대돼.",
 "377": "그 뒤로 나도 수련을 쌓았거든.",
 "378": "너도 확실히 강해지고 있어. 서로 힘내자.",
 "379": "승부는 운……이라잖아.",
 "380": "뭐, 돈은 안 되지만.",
 "381": "응, 뭐가 됐든 이긴다는 건 나쁘지 않네.",
 "382": "뭐, 다치지도 않고 끝났으니 다행이다 다행이야.",
 "383": "저기, 너. 더 강해지지 않으면 다칠 거야.",
 "384": "우후후, 아프겠다. 미안해.",
 "385": "미안하지만 내가 너무 강했나 봐. 미안해{E}#04{E}#",
 "386": "에헤{E}#04{E}#이겨 버렸다~{E}#0B{E}#",
 "387": "아~, 아프겠다. 다음엔 살살 해 줄게.",
 "388": "아하하……기분 좋아~.",
 "389": "후~, 속 시원하다.",
 "390": "너, 빈틈투성이야!",
 "391": "훗, 이 정도 상대로는 부족해.",
 "392": "호호호, 뭐, 이게 실력이지.",
 "393": "져도 분해할 필요 없어. 상대가 나빴던 거니까.",
 "394": "내가 상대라면 어쩔 수 없지. 운이 나빴던 거야, 너.",
 "395": "다음에는 더 우아하게 이겨 보이겠어요.",
 "396": "열심히 연습한 보람이 있었어.",
 "397": "해냈다! 이겼어{E}#04{E}#",
 "398": "아~, 이겨서 다행이다.",
 "399": "이것도 수련의 성과야.",
 "400": "분해.",
 "401": "져 버렸어.",
 "402": "아~, 좀 더 침착하게 겨뤘더라면……!",
 "403": "으~음, 못 이길 승부는 아니었던 것 같은데…",
 "404": "후후후. 분하면 더 강해지라고.",
 "405": "아아, 아파……아리엘도 참 괴력이야……{E}#06{E}#",
 "406": "아쉽네, 내 수련이 한 수 위였다는 거야.",
 "407": "왠지 분해……",
 "408": "신경 쓰지 마. 『승패는 병가지상사』라잖아.",
 "409": "오케이. 다음엔 이길 거야.",
 "410": "훗, 다음 대전이 기대되네. 기대하고 있을게.",
 "411": "으~음……왠지 자신감을 잃어 버렸어.",
 "412": "아~아, 아프고, 배는 고프고, 좋은 일이 하나도 없네……",
 "413": "역시 하지 말걸. 아파~.",
 "414": "뭐, 어쩔 수 없지. 안 다친 것만으로도 다행으로 치자.",
 "415": "아~, 왠지 손해 본 기분. 우울해질 것 같아……",
 "416": "아파~……연습이 부족한 걸까……",
 "417": "아~앙, 그렇게 진심으로 때릴 건 없잖아……",
 "418": "져 버렸다. 너 강하구나{E}#04{E}#",
 "419": "강한 사람, 나 좋아해{E}#04{E}#",
 "420": "앗! …………두근두근{E}#06{E}#",
 "421": "이 녀석, 상대를 놀리지 마라.",
 "422": "네~, 죄송해요~.",
 "423": "나는 칼 같은 건 영 소질이 없는 사람인가 봐……훌쩍.",
 "424": "쳇……",
 "425": "……자신 있었는데.",
 "426": "정정당당하게 해서 진 거야. 어쩔 수 없지……",
 "427": "안 돼. 이래서는 안 돼.",
 "428": "믿을 수 없어! 이 내가 지다니……",
 "429": "오늘은 아침부터 몸 상태가 좀 안 좋았고……",
 "430": "이놈, 변명은 듣지 않겠다.",
 "431": "…………네~에.",
 "432": "이 나를 이기다니, 너 보통이 아니구나.",
 "433": "그, 그런가?",
 "434": "그래. 자신감을 가지렴.",
 "435": "고, 고맙습니다……",
 "436": "이걸 격려 삼아 더욱 수련하도록 해!",
 "437": "네, 네! ……어째 내가 진 것 같은 기분……",
 "438": "뭐, 원숭이도 나무에서 떨어진다는 거겠지……",
 "439": "나는 재능이 없는 걸지도……",
 "440": "아파~. 왠지 최악의 기분……",
 "441": "져 버렸어……수련이 부족한 걸까.",
 "442": "분해……다음에야말로 꼭……!",
 "443": "그만! {E}%frstname의 승리.",
 "444": "그만!",
 "445": "의 승리.",
 "446": "\n라이벌",
 "447": "\n단짝",
 "448": "\n무술 시합 보통",
 "449": "\n무술 시합-아놀드에게 승-보통",
 "450": "\n무술 시합-랜디에게 승-가난",
 "451": "\n무술 시합-버크벡에게 승-색기 과다",
 "452": "\n무술 시합-체코에게 승-건방",
 "453": "\n무술 시합-아리엘에게 승-비행",
 "454": "\n무술 시합-아놀드에게 패-보통",
 "455": "\n무술 시합-랜디에게 패-가난",
 "456": "\n무술 시합-버크벡에게 패-색기 과다",
 "457": "\n무술 시합-체코에게 패-건방",
 "458": "\n무술 시합-아리엘에게 패-비행",
 "459": "\n딸의 상태 {E}%102    일수 = {E}%101",
 "460": "아가씨~. 고양이 상태가 좀 이상해요.",
 "461": "{E}%neko, 왜 그래. 어머, 아픈가 봐……",
 "462": "불쌍하게. 내가 간호할게.",
 "463": "아가씨~. 스케줄은요~?",
 "464": "{E}%neko, 죽지 마.",
 "465": "주인님, 스케줄은 취소인 것 같아요~.",
 "466": "\n딸의 상태 {E}%102",
 "467": "나는 일정이 있으니까, 우즈가 잘 간호해 줘.",
 "468": "네네. 어차피 그럴 줄 알았어요.",
 "469": "내가 목수 우두머리 오글리비다.",
 "470": "목수 일은 꽤 체력이 필요하지.",
 "471": "뭐, 뻗지 않을 정도로 따라와.",
 "472": "자~, 근성, 근성, 왕근성이다{E}#0B{E}#",
 "473": "오, 신났구먼.",
 "474": "자, 열심히 벌어 볼까~.",
 "475": "목수 일은 좋아. 뭐니 뭐니 해도 급료가 좋아!!",
 "476": "좋~아, 지금이야말로 벌 때. 힘내, {E}%frstname.",
 "477": "어이, 멋 부리지 말고. 얼른 일해.",
 "478": "으~음, 아무래도 이 아르바이트는 도움이 안 될 예감이 들어.",
 "479": "목수는 사내 일이야. 하늘하늘한 계집애는 못 해 먹어.",
 "480": "나, 하늘하늘하지 않은걸~{E}#05{E}#",
 "481": "음~, 목수 일은 왠지 힘들 것 같아~.",
 "482": "좋았어, 일 잘하는구먼. 몸 바쳐 일하는 근성이 마음에 들었다!",
 "483": "얼마 안 되지만 받아 둬. 뭐, 위로금 대신이야.",
 "484": "좋았어, 일 잘하는구먼. 장래가 기대되는걸.",
 "485": "얼마 안 되지만 받아 둬. 작은 성의야.",
 "486": "어머, 대장님은 인심이 좋으시네요{E}#0B{E}#",
 "487": "수고했어, 도움이 됐다. 또 와 줘.",
 "488": "소질이 있구먼. 또 와.",
 "489": "으~음, 이거 좋은 솜씨야.",
 "490": "목수 일도 익숙해지니까 재밌네.",
 "491": "어, 수고했어.",
 "492": "어, 오늘로 끝인가. 수고했다!",
 "493": "체력이 없으면 일단 이 일은 못 버티지.",
 "494": "후우~ 지쳤다.",
 "495": "뭐야, 몸이 약해진 거 아냐?",
 "496": "글렀구먼. 피로가 쌓인 거 아냐?",
 "497": "목수 일은 결국 체력 싸움이야.",
 "498": "아~, 전혀 안 될지도……",
 "499": "『지도』가 아냐. 안 돼! 다.",
 "500": "카~! 영 쓸모없는 아가씨로구먼.",
 "501": "어라? 너 있었냐? 몰랐네.",
 "502": "아아, 쓸모없다는 게 바로 이런 거지.",
 "503": "아~아, 오늘도 실수해서 혼났어……",
 "504": "쯧쯧, 얼른 돌아가. 일에 방해돼.",
 "505": "글렀어. 이거……",
 "506": "아~아, 이제 갈래……",
 "507": "후~, 이런 모습, 아빠한테는 보이고 싶지 않아.",
 "508": "덥구먼. 이렇게 더워서야 몸이 못 버티겠다."
}